TVT_APP_NAME=TVT
TVT_ADDR=127.0.0.1:9911
TVT_BASE_URL=https://example.com
TVT_DB=/var/lib/tvt/tvt.db
TVT_JWT_SECRET=change-me-to-at-least-32-random-characters
TVT_TMDB_KEY=
TVT_ADMIN_EMAIL=
TVT_DEFAULT_LANG=en
TVT_SMTP_HOST=
TVT_SMTP_PORT=587
TVT_SMTP_USER=
TVT_SMTP_PASS=
TVT_MAIL_FROM=
TVT_DEV_LOG_MAIL=
TVT_DATA_DIR=/var/lib/tvt/data
TVT_TELEGRAM_BOT_TOKEN=
TVT_TELEGRAM_BOT_USERNAME=
# Header the reverse proxy uses for the client address (right-most entry is used).
# Behind Cloudflare set CF-Connecting-IP.
TVT_CLIENT_IP_HEADER=X-Forwarded-For
# Real per-episode air times come from TVmaze (free, no key). Set to 1 to disable.
TVT_DISABLE_TVMAZE=
# Optional S3-compatible storage (Cloudflare R2, AWS S3, MinIO, Backblaze B2, ...) for uploads and cached artwork.
# Set endpoint, bucket, key id, secret and TVT_MEDIA_PUBLIC_URL (below) together, or none of them; with none, files live on local disk under TVT_DATA_DIR/media.
# For Cloudflare R2 the endpoint is https://<account id>.r2.cloudflarestorage.com
TVT_S3_ENDPOINT=
TVT_S3_REGION=
TVT_S3_BUCKET=
TVT_S3_ACCESS_KEY_ID=
TVT_S3_SECRET_ACCESS_KEY=
TVT_S3_PREFIX=
# Optional second source for episode air times (free key from trakt.tv/oauth/applications).
TVT_TRAKT_CLIENT_ID=
# Optional second catalog for shows TMDB lacks (YouTube and web series). Needs a TheTVDB API key; TheTVDB requires attribution, which TVT shows.
TVT_TVDB_KEY=
# Friends on other TVT servers. On by default; set to 0 to disable. Block servers by listing hosts, separated by commas.
TVT_FEDERATION=1
TVT_FEDERATION_BLOCK=
# Optional allowlist: when set, only these hosts may federate with this server.
TVT_FEDERATION_ALLOW=
# Shown on the privacy page. The AGPL requires every network user to be offered the source: keep TVT_SOURCE_URL pointing at the code you run.
TVT_SOURCE_URL=https://github.com/CarlSinclair/tvt
TVT_OPERATOR_NAME=
TVT_PRIVACY_CONTACT=
# Required when the S3 settings above are used: the public https domain of the bucket (for R2, a custom domain on it). Browsers fetch images straight from it.
# Leave empty (with no S3 settings) to keep files on local disk.
TVT_MEDIA_PUBLIC_URL=
