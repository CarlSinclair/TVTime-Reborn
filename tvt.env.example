# Only what the process needs before it can read its own database stays here.
# Everything else (mail, storage, API keys, Telegram bot, site name, operator
# details, federation switch) is set in Admin > Config and Admin > Servers.
# An existing install imports those values from this file once, on the first
# start after upgrading; after that this file is no longer read for them.
TVT_ADDR=127.0.0.1:9911
TVT_BASE_URL=https://example.com
TVT_DB=/var/lib/tvt/tvt.db
TVT_DATA_DIR=/var/lib/tvt/data
TVT_JWT_SECRET=change-me-to-at-least-32-random-characters
# The verified email of the person who becomes admin.
TVT_ADMIN_EMAIL=
# Header the reverse proxy uses for the client address (right-most entry is used).
# Behind Cloudflare set CF-Connecting-IP.
TVT_CLIENT_IP_HEADER=X-Forwarded-For
# Logs sign-in links instead of sending mail; refused on an https base URL.
TVT_DEV_LOG_MAIL=
# Hardening for federation: block servers by host, or only allow the listed hosts (comma separated).
TVT_FEDERATION_BLOCK=
TVT_FEDERATION_ALLOW=
